<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widgetRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget_glass"
    android:orientation="horizontal"
    android:padding="10dp">

    <!-- Left Column: Mascot & Streak Pill -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/ivWidgetMascot"
            android:layout_width="66dp"
            android:layout_height="66dp"
            android:contentDescription="Маскот посещаемости"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_squirrel_on_fire" />

        <!-- Streak Badge Pill -->
        <LinearLayout
            android:id="@+id/layoutStreakBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:background="@drawable/bg_widget_bubble"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingHorizontal="7dp"
            android:paddingVertical="2dp">

            <TextView
                android:id="@+id/tvWidgetStreakCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔥 7 пар"
                android:textColor="#191837"
                android:textSize="11.5sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Right Column: Speech Bubble + Next Info + Action Button -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginStart="8dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- Speech Bubble Container -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@drawable/bg_widget_bubble"
            android:orientation="vertical"
            android:paddingHorizontal="9dp"
            android:paddingVertical="5dp">

            <TextView
                android:id="@+id/tvWidgetMascotTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Белка-Связист:"
                android:textColor="#1F55D8"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvWidgetQuote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:ellipsize="end"
                android:maxLines="3"
                android:lineSpacingMultiplier="1.05"
                android:text="Пинг 1 мс! Пакеты доставлены, закрывай пары без потерь!"
                android:textColor="#191837"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Bottom Controls: Next Info & Action Button -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvWidgetNextLesson"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:singleLine="true"
                android:text="Пары окончены 🎉"
                android:textColor="#334155"
                android:textSize="11sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnWidgetScan"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_widget_btn_action"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:paddingHorizontal="8dp"
                android:paddingVertical="0dp"
                android:text="⚡ QR"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="10.5sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
