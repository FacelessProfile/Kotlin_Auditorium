<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="12dp"
    android:gravity="center_vertical"
    android:background="?attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvInnerGradeTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Задание 1"
            android:textSize="14sp"
            android:textColor="?android:attr/textColorPrimary"/>

        <TextView
            android:id="@+id/tvInnerGradeType"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Тип: Экзамен"
            android:textSize="12sp"
            android:textColor="?android:attr/textColorSecondary"/>
    </LinearLayout>

    <TextView
        android:id="@+id/tvInnerGradeScore"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="10 / 10"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="?android:attr/textColorPrimary"/>

    <ImageButton
        android:id="@+id/ibDeleteGrade"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginStart="8dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@android:drawable/ic_menu_delete"
        android:contentDescription="Удалить оценку"/>

</LinearLayout>
