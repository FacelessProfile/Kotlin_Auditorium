<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardBackgroundColor="?attr/sib_bg_card"
    app:cardCornerRadius="12dp"
    app:cardElevation="1dp"
    app:strokeColor="?attr/sib_border_subtle"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvTicketCategoryBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_role_pill"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:textColor="@color/sib_blue_primary"
                android:textSize="11sp"
                android:textStyle="bold"
                tools:text="Ошибка / Баг" />

            <TextView
                android:id="@+id/tvTicketId"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:textColor="?attr/sib_text_secondary"
                android:textSize="12sp"
                tools:text="#14" />

            <TextView
                android:id="@+id/tvTicketStatusBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_done_count_badge"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold"
                tools:text="Открыт" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvTicketTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="?attr/sib_text_primary"
            android:textSize="15sp"
            android:textStyle="bold"
            tools:text="Не отображаются оценки по физике" />

        <TextView
            android:id="@+id/tvTicketDescPreview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="?attr/sib_text_secondary"
            android:textSize="13sp"
            tools:text="После обновления приложения пропала вкладка с оценками за прошлый семестр..." />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvTicketDate"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="?attr/sib_text_muted"
                android:textSize="11sp"
                tools:text="20.09.2026, 14:30" />

            <TextView
                android:id="@+id/tvAttachmentsCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawableStart="@drawable/ic_camera"
                android:drawablePadding="4dp"
                android:drawableTint="?attr/sib_text_muted"
                android:textColor="?attr/sib_text_muted"
                android:textSize="11sp"
                android:visibility="gone"
                tools:text="2 фото"
                tools:visibility="visible" />
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
