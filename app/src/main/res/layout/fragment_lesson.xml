<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/sib_bg_page">

    <!-- Top Minimalist NFC Status Bar -->
    <LinearLayout
        android:id="@+id/layoutTopHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end|center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="6dp"
        app:layout_constraintTop_toTopOf="parent">

        <!-- NFC Status Pill -->
        <LinearLayout
            android:id="@+id/layoutNfcStatusPill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_badge_ontime"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="10dp"
            android:paddingVertical="5dp">

            <ImageView
                android:id="@+id/statusIcon"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_nfc"
                app:tint="@color/badge_ontime_text" />

            <TextView
                android:id="@+id/tvLessonStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="NFC готов"
                android:textColor="@color/badge_ontime_text"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- ============================================================= -->
    <!-- STATE 1: NO ACTIVE LESSON                                     -->
    <!-- ============================================================= -->
    <LinearLayout
        android:id="@+id/layoutNoLesson"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:visibility="visible"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layoutTopHeader">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="?attr/sib_bg_card"
            app:cardCornerRadius="20dp"
            app:cardElevation="1dp"
            app:strokeColor="?attr/sib_border_subtle"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingHorizontal="24dp"
                android:paddingVertical="32dp">

                <FrameLayout
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:background="@drawable/bg_icon_container_blue">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_schedule_clock"
                        app:tint="@color/sib_blue_primary" />
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="Нет активного занятия"
                    android:textColor="?attr/sib_text_primary"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:text="Запустите пару, чтобы студенты могли отметиться через динамический QR-код или NFC"
                    android:textColor="?attr/sib_text_secondary"
                    android:textSize="13sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCreateLessonHero"
                    style="@style/Widget.MaterialComponents.Button"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="24dp"
                    android:text="Начать занятие"
                    android:textColor="@color/sib_text_white"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    app:backgroundTint="@color/sib_blue_primary"
                    app:cornerRadius="14dp"
                    app:elevation="2dp"
                    app:icon="@drawable/ic_add"
                    app:iconGravity="textStart"
                    app:iconTint="@color/sib_text_white" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnNoLessonAllStudents"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="10dp"
                    android:text="Список всех студентов"
                    android:textColor="?attr/sib_text_secondary"
                    android:textSize="13sp"
                    app:cornerRadius="14dp"
                    app:strokeColor="?attr/sib_border_subtle" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Hidden compat views -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardAllStudentsShortcut"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

    </LinearLayout>

    <!-- ============================================================= -->
    <!-- STATE 2: ACTIVE LESSON                                        -->
    <!-- ============================================================= -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutActiveLesson"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layoutTopHeader">

        <!-- Active Lesson Compact Info Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardActiveBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="2dp"
            app:cardBackgroundColor="?attr/sib_bg_card"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeColor="?attr/sib_border_subtle"
            app:strokeWidth="1dp"
            app:layout_constraintTop_toTopOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp"
                android:paddingVertical="12dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvActiveSubjectTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="?attr/sib_text_primary"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        tools:text="Компьютерные сети" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvActiveGroups"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="?attr/sib_text_secondary"
                            android:textSize="12sp"
                            tools:text="Группы: ПИ-21" />

                        <TextView
                            android:id="@+id/tvSessionTimer"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/bg_stat_mini_card"
                            android:paddingHorizontal="6dp"
                            android:paddingVertical="2dp"
                            android:textColor="@color/sib_blue_primary"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:visibility="gone"
                            tools:text="⏳ 82 мин"
                            tools:visibility="visible" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Live Counter Badge -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_badge_ontime"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp">

                    <TextView
                        android:id="@+id/tvLivePresentCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/badge_ontime_text"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        tools:text="👥 18" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Dynamic QR Code Card with Quiet Zone Margin -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardQrContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="8dp"
            app:cardBackgroundColor="?attr/sib_bg_card"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeColor="?attr/sib_border_subtle"
            app:strokeWidth="1dp"
            app:layout_constraintTop_toBottomOf="@id/cardActiveBanner">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingHorizontal="12dp"
                android:paddingVertical="10dp">

                <!-- Inner White Quiet Zone Container for Scanner Reliability -->
                <FrameLayout
                    android:id="@+id/layoutQrWhiteContainer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_stat_mini_card"
                    android:backgroundTint="#FFFFFF"
                    android:padding="8dp">

                    <ImageView
                        android:id="@+id/ivQrCode"
                        android:layout_width="140dp"
                        android:layout_height="140dp"
                        android:layout_gravity="center"
                        android:contentDescription="QR код для отметки"
                        android:visibility="visible" />
                </FrameLayout>

                <TextView
                    android:id="@+id/tvLessonSubStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Приложите телефон или отсканируйте QR (обновление каждые 5с)"
                    android:textColor="?attr/sib_text_secondary"
                    android:textSize="11sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Live Attendance Roster Section Header -->
        <LinearLayout
            android:id="@+id/layoutPresentSectionHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintTop_toBottomOf="@id/cardQrContainer">

            <TextView
                android:id="@+id/tvListTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Явка студентов"
                android:textColor="?attr/sib_text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvPresentCounterBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge_ontime"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"
                android:textColor="@color/badge_ontime_text"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:text="18 / 25" />
        </LinearLayout>

        <!-- Present Students List -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerViewAttendance"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="4dp"
            android:clipToPadding="false"
            android:paddingBottom="72dp"
            app:layout_constraintBottom_toTopOf="@id/layoutBottomBar"
            app:layout_constraintTop_toBottomOf="@id/layoutPresentSectionHeader"
            tools:listitem="@layout/item_roster_student" />

        <!-- Empty State inside Active Lesson -->
        <LinearLayout
            android:id="@+id/layoutEmptyAttendance"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="20dp"
            android:visibility="gone"
            app:layout_constraintBottom_toTopOf="@id/layoutBottomBar"
            app:layout_constraintTop_toBottomOf="@id/layoutPresentSectionHeader">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ожидание отметок..."
                android:textColor="?attr/sib_text_muted"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Bottom Action Bar -->
        <LinearLayout
            android:id="@+id/layoutBottomBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="12dp"
            android:gravity="center"
            android:orientation="horizontal"
            app:layout_constraintBottom_toBottomOf="parent">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnViewAllStudents"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:text="Все студенты"
                android:textColor="?attr/sib_text_secondary"
                android:textSize="13sp"
                app:cornerRadius="14dp"
                app:strokeColor="?attr/sib_border_subtle" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnFinishLesson"
                style="@style/Widget.MaterialComponents.Button"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1.2"
                android:text="Завершить пару"
                android:textColor="@color/sib_text_white"
                android:textSize="13sp"
                android:textStyle="bold"
                app:backgroundTint="@color/sib_error_vibrant"
                app:cornerRadius="14dp"
                app:elevation="0dp"
                app:icon="@drawable/ic_stop_lesson"
                app:iconTint="@color/sib_text_white" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Hidden compat views -->
    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/fabCreateLesson"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardStatus"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>