<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/sib_bg_page"
    android:padding="16dp">

    <!-- Hero Card Header -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        app:cardCornerRadius="18dp"
        app:cardElevation="2dp"
        app:strokeWidth="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_hero_gradient"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Аутентификатор TOTP"
                android:textColor="@color/sib_text_white"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Одноразовые 6-значные коды подтверждения"
                android:textColor="#D0E2FF"
                android:textSize="13sp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Main TOTP Generator Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardTotpActive"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="?attr/sib_bg_card"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:strokeColor="?attr/sib_border_subtle"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Текущий одноразовый код"
                android:textColor="?attr/sib_text_secondary"
                android:textSize="13sp" />

            <!-- Circular Progress Ring Container -->
            <FrameLayout
                android:layout_width="180dp"
                android:layout_height="180dp"
                android:layout_marginVertical="20dp">

                <ProgressBar
                    android:id="@+id/pbTotpTime"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:max="30"
                    android:progress="30"
                    android:progressDrawable="@drawable/circular_progress" />

                <TextView
                    android:id="@+id/tvTotpCode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:letterSpacing="0.08"
                    android:textColor="?attr/sib_text_primary"
                    android:textSize="34sp"
                    android:textStyle="bold"
                    tools:text="492 815" />
            </FrameLayout>

            <TextView
                android:id="@+id/tvRemainingSeconds"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/sib_blue_primary"
                android:textSize="13sp"
                android:textStyle="bold"
                tools:text="Обновится через: 24 сек" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCopyTotpCode"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginTop="16dp"
                android:text="Скопировать код"
                android:textColor="?attr/sib_text_primary"
                android:textSize="13sp"
                app:cornerRadius="12dp"
                app:icon="@drawable/ic_done_all"
                app:iconTint="@color/sib_blue_primary"
                app:strokeColor="?attr/sib_border_subtle" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Disabled State Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardTotpDisabled"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:cardBackgroundColor="?attr/sib_bg_card"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:strokeColor="?attr/sib_border_subtle"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="32dp">

            <ImageView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:src="@drawable/ic_security_badge"
                app:tint="?attr/sib_text_muted" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="2FA не активирована"
                android:textColor="?attr/sib_text_primary"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvNotEnabled"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:text="Для генерации кодов подтверждения включите двухфакторную аутентификацию в Настройках"
                android:textColor="?attr/sib_text_secondary"
                android:textSize="13sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGoToSettings"
                style="@style/Widget.MaterialComponents.Button"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginTop="20dp"
                android:text="Перейти в Настройки"
                android:textColor="@color/sib_text_white"
                android:textSize="13sp"
                app:backgroundTint="@color/sib_blue_primary"
                app:cornerRadius="12dp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</LinearLayout>
