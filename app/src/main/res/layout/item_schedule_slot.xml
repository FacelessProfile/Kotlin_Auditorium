<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardScheduleSlot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="1dp"
    app:strokeWidth="1dp"
    app:strokeColor="@color/card_stroke"
    app:cardBackgroundColor="@color/card_surface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Slot Header: Pair Number + Time Interval + Dots Indicator -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="14dp"
            android:paddingTop="11dp"
            android:paddingBottom="4dp">

            <!-- Pair Number Badge (e.g. "1 пара") -->
            <TextView
                android:id="@+id/tvLessonNumBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1 пара"
                android:textSize="11.5sp"
                android:textStyle="bold"
                android:textColor="@color/uni_blue_primary"
                android:background="@drawable/bg_badge_type"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"/>

            <!-- Time Interval (e.g. "08:00 – 09:35") -->
            <TextView
                android:id="@+id/tvScheduleTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="08:00 – 09:35"
                android:textSize="12.5sp"
                android:textStyle="bold"
                android:textColor="@color/text_muted"
                android:layout_marginStart="8dp"/>

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"/>

            <!-- Dots Indicator Container (Shown ONLY when slot has multiple parallel lessons) -->
            <LinearLayout
                android:id="@+id/layoutDotsContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_badge_type"
                android:paddingHorizontal="7dp"
                android:paddingVertical="4dp"
                android:visibility="gone">

                <!-- Dynamic dots populated by adapter, e.g. ● ○ -->
                <LinearLayout
                    android:id="@+id/layoutDotsList"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Horizontal RecyclerView with PagerSnapHelper for smooth swipe between lessons -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvSlotLessons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:nestedScrollingEnabled="false"
            android:overScrollMode="never"/>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
