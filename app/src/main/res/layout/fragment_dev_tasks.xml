<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sib_bg_page">

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefresh"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="80dp">

                <!-- Sprint Banner Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardSprintBanner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="12dp"
                    app:cardBackgroundColor="@color/sib_card_surface"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp"
                    app:strokeColor="@color/sib_border"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tvSprintName"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:textColor="@color/sib_text_primary"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                tools:text="Спринт 1 (07.09 – 14.09)" />

                            <TextView
                                android:id="@+id/tvSprintStatus"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="#EEFDF4"
                                android:paddingHorizontal="8dp"
                                android:paddingVertical="3dp"
                                android:text="Активен"
                                android:textColor="#16A34A"
                                android:textSize="11sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvSprintDates"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:textColor="@color/sib_text_secondary"
                            android:textSize="12sp"
                            tools:text="Пн 12:00 НСК — Пн 11:59 НСК (авто-ролловер)" />

                        <!-- Progress Bar -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ProgressBar
                                android:id="@+id/pbSprintCompletion"
                                style="?android:attr/progressBarStyleHorizontal"
                                android:layout_width="0dp"
                                android:layout_height="8dp"
                                android:layout_weight="1"
                                android:max="100"
                                android:progress="65"
                                android:progressTint="#16A34A" />

                            <TextView
                                android:id="@+id/tvSprintPercent"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="10dp"
                                android:textColor="@color/sib_blue_primary"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                tools:text="65%" />
                        </LinearLayout>

                        <!-- Quick Stats summary -->
                        <TextView
                            android:id="@+id/tvSprintStatsSummary"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:textColor="@color/sib_text_secondary"
                            android:textSize="12sp"
                            tools:text="Задач: 4/6 выполнено • Багов: 2/3 закрыто" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Filter Chips Row (All vs My Tasks) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="12dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnFilterAll"
                        style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:backgroundTint="@color/sib_blue_primary"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:text="Все задачи"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        app:cornerRadius="19dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnFilterMy"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:layout_marginStart="8dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:text="Мои задачи"
                        android:textColor="@color/sib_text_secondary"
                        android:textSize="12sp"
                        app:cornerRadius="19dp"
                        app:strokeColor="@color/sib_border" />
                </LinearLayout>

                <!-- Section 1: TODO TASKS -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="14dp"
                    android:layout_marginTop="16dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="В работе"
                        android:textColor="@color/sib_text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvTodoCountBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_priority_medium"
                        android:paddingHorizontal="6dp"
                        android:paddingVertical="1dp"
                        android:textColor="@color/sib_blue_primary"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        tools:text="2" />
                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvTodoTasks"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:nestedScrollingEnabled="false"
                    tools:itemCount="2"
                    tools:listitem="@layout/item_dev_task" />

                <!-- Empty Todo View -->
                <TextView
                    android:id="@+id/tvEmptyTodo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:padding="20dp"
                    android:text="Нет активных задач в этом спринте"
                    android:textColor="@color/sib_text_muted"
                    android:textSize="13sp"
                    android:visibility="gone" />

                <!-- Section 2: DONE TASKS -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="14dp"
                    android:layout_marginTop="20dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Выполнено"
                        android:textColor="#16A34A"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvDoneCountBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_done_count_badge"
                        android:paddingHorizontal="6dp"
                        android:paddingVertical="1dp"
                        android:textColor="#16A34A"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        tools:text="4" />
                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvDoneTasks"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:nestedScrollingEnabled="false"
                    tools:itemCount="3"
                    tools:listitem="@layout/item_dev_task" />

                <!-- Empty Done View -->
                <TextView
                    android:id="@+id/tvEmptyDone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:padding="20dp"
                    android:text="Выполненных задач пока нет"
                    android:textColor="@color/sib_text_muted"
                    android:textSize="13sp"
                    android:visibility="gone" />

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <!-- Floating Action Button: Add Task -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabAddTask"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="20dp"
        android:backgroundTint="@color/sib_blue_primary"
        android:contentDescription="Добавить задачу"
        android:src="@drawable/ic_add"
        app:tint="#FFFFFF" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
