<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="1dp"
    app:strokeWidth="1dp"
    app:strokeColor="@color/card_stroke"
    app:cardBackgroundColor="@color/card_surface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <!-- Left Accent Color Strip -->
        <View
            android:id="@+id/viewLessonColorStrip"
            android:layout_width="4.5dp"
            android:layout_height="match_parent"
            android:background="@color/uni_blue_primary"/>

        <!-- Main Card Content -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="14dp"
            android:paddingVertical="11dp">

            <!-- Top Row: Pair Number + Time (Left) & Lesson Type Chip (Right) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <!-- Pair Number Badge -->
                <TextView
                    android:id="@+id/tvLessonNumBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1 пара"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="@color/uni_blue_primary"
                    android:background="@drawable/bg_badge_type"
                    android:paddingHorizontal="7dp"
                    android:paddingVertical="2.5dp"/>

                <!-- Time Interval -->
                <TextView
                    android:id="@+id/tvScheduleTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="08:00 – 09:35"
                    android:textSize="12.5sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_muted"
                    android:layout_marginStart="8dp"/>

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"/>

                <!-- Lesson Type Badge -->
                <TextView
                    android:id="@+id/tvScheduleLessonType"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Лекция"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="@color/badge_type_text"
                    android:background="@drawable/bg_badge_type"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="2.5dp"/>
            </LinearLayout>

            <!-- Middle Row: Subject Title -->
            <TextView
                android:id="@+id/tvScheduleSubject"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Алгоритмы и структуры данных"
                android:textSize="15.5sp"
                android:textStyle="bold"
                android:textColor="@color/text_main"
                android:maxLines="2"
                android:ellipsize="end"
                android:layout_marginTop="7dp"/>

            <!-- Row 3: Teacher / Group Row (Never Truncated) -->
            <LinearLayout
                android:id="@+id/layoutTeacherOrGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="5dp">

                <ImageView
                    android:id="@+id/ivTeacherGroupIcon"
                    android:layout_width="13dp"
                    android:layout_height="13dp"
                    android:src="@drawable/ic_person"
                    app:tint="@color/text_muted"
                    android:layout_marginEnd="5dp"/>

                <TextView
                    android:id="@+id/tvTeacherOrGroup"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Тестовый Преподаватель"
                    android:textSize="12.5sp"
                    android:textColor="@color/text_muted"
                    android:maxLines="1"
                    android:ellipsize="end"/>
            </LinearLayout>

            <!-- Row 4: Room & Subgroup (Clean Metadata) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="4dp">

                <TextView
                    android:id="@+id/tvScheduleRoom"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ауд. 401"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/badge_time_text"
                    android:background="@drawable/bg_badge_time"
                    android:paddingHorizontal="7dp"
                    android:paddingVertical="2dp"/>

                <TextView
                    android:id="@+id/tvScheduleSubgroup"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Вся группа"
                    android:textSize="11.5sp"
                    android:textColor="@color/text_subtle"
                    android:layout_marginStart="8dp"
                    android:visibility="gone"/>
            </LinearLayout>

        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
