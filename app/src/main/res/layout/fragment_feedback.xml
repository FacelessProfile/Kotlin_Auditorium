<?xml version="1.0" encoding="utf-8"?>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/swipeRefreshFeedback"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/sib_bg_page">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Developer Blocked Message -->
            <LinearLayout
                android:id="@+id/layoutDevRestricted"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_task_card"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="24dp"
                android:visibility="gone"
                tools:visibility="gone">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/ic_terminal_code"
                    app:tint="@color/sib_blue_primary"
                    android:contentDescription="Dev" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Панель разработчика"
                    android:textColor="?attr/sib_text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:text="Форма обратной связи предназначена для студентов и преподавателей. Для разработчиков доступен внутренний трекер задач и дефектов."
                    android:textColor="?attr/sib_text_secondary"
                    android:textSize="13sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnGoToDevTasks"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Перейти к задачам"
                    app:cornerRadius="8dp" />
            </LinearLayout>

            <!-- Main Feedback Container (for students/teachers/non-devs) -->
            <LinearLayout
                android:id="@+id/layoutFeedbackContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Tabs Row -->
                <com.google.android.material.tabs.TabLayout
                    android:id="@+id/tabLayoutFeedback"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:background="@drawable/bg_spinner_field"
                    app:tabGravity="fill"
                    app:tabIndicatorColor="@color/sib_blue_primary"
                    app:tabIndicatorHeight="3dp"
                    app:tabMode="fixed"
                    app:tabRippleColor="?attr/sib_border_subtle"
                    app:tabSelectedTextColor="@color/sib_blue_primary"
                    app:tabTextAppearance="@style/TextAppearance.MaterialComponents.Caption"
                    app:tabTextColor="?attr/sib_text_secondary">

                    <com.google.android.material.tabs.TabItem
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Новое обращение" />

                    <com.google.android.material.tabs.TabItem
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Мои обращения" />
                </com.google.android.material.tabs.TabLayout>

                <!-- 1. CREATE TICKET VIEW -->
                <LinearLayout
                    android:id="@+id/viewCreateTicket"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="vertical">

                    <!-- Category Selection -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Категория"
                        android:textColor="?attr/sib_text_primary"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/chipGroupCategory"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        app:singleSelection="true">

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipBug"
                            style="@style/Widget.MaterialComponents.Chip.Choice"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            android:text="🐛 Ошибка / Баг" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipFeature"
                            style="@style/Widget.MaterialComponents.Chip.Choice"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="💡 Предложение" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipQuestion"
                            style="@style/Widget.MaterialComponents.Chip.Choice"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="❓ Вопрос" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipOther"
                            style="@style/Widget.MaterialComponents.Chip.Choice"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="📌 Другое" />
                    </com.google.android.material.chip.ChipGroup>

                    <!-- Title -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:hint="Краткая тема обращения"
                        app:boxStrokeColor="@color/sib_blue_primary"
                        app:counterEnabled="true"
                        app:counterMaxLength="120">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etFeedbackTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textCapSentences"
                            android:maxLength="120"
                            android:maxLines="1"
                            android:textSize="14sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Description -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:hint="Подробное описание проблемы или идеи"
                        app:boxStrokeColor="@color/sib_blue_primary"
                        app:counterEnabled="true"
                        app:counterMaxLength="4000">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etFeedbackDescription"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="top|start"
                            android:inputType="textMultiLine|textCapSentences"
                            android:maxLength="4000"
                            android:minLines="4"
                            android:textSize="14sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Photos Section -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Фотографии / Скриншоты (до 5 шт.)"
                        android:textColor="?attr/sib_text_primary"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/rvAttachments"
                            android:layout_width="0dp"
                            android:layout_height="76dp"
                            android:layout_weight="1"
                            android:orientation="horizontal"
                            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnAddPhoto"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="wrap_content"
                            android:layout_height="48dp"
                            android:layout_marginStart="8dp"
                            android:text="+ Фото"
                            app:cornerRadius="8dp"
                            app:icon="@drawable/ic_camera"
                            app:strokeColor="?attr/sib_border_subtle" />
                    </LinearLayout>

                    <!-- Diagnostic Info Switch -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        app:cardBackgroundColor="?attr/sib_bg_card"
                        app:cardCornerRadius="10dp"
                        app:strokeColor="?attr/sib_border_subtle"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="12dp">

                            <com.google.android.material.switchmaterial.SwitchMaterial
                                android:id="@+id/switchDiagnostics"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:checked="true"
                                android:text="Прикрепить диагностику устройства"
                                android:textColor="?attr/sib_text_primary"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                app:useMaterialThemeColors="true" />

                            <TextView
                                android:id="@+id/tvDiagnosticsPreviewHint"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="Помогает разработчикам быстрее найти и устранить причину проблемы."
                                android:textColor="?attr/sib_text_secondary"
                                android:textSize="11sp" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Submit Button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSubmitFeedback"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginTop="18dp"
                        android:text="Отправить обращение"
                        android:textSize="15sp"
                        app:cornerRadius="10dp"
                        app:icon="@drawable/ic_send" />

                    <ProgressBar
                        android:id="@+id/progressSubmit"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="10dp"
                        android:visibility="gone" />

                </LinearLayout>

                <!-- 2. HISTORY TICKETS VIEW -->
                <LinearLayout
                    android:id="@+id/viewHistoryTickets"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="vertical"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvMyTickets"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false"
                        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

                    <!-- Empty State -->
                    <LinearLayout
                        android:id="@+id/layoutEmptyTickets"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="32dp"
                        android:visibility="gone"
                        tools:visibility="gone">

                        <ImageView
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:src="@drawable/ic_comment"
                            app:tint="?attr/sib_text_muted"
                            android:contentDescription="Empty" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="Нет отправленных обращений"
                            android:textColor="?attr/sib_text_primary"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Создайте новое обращение, если у вас возникли трудности или есть идеи."
                            android:textColor="?attr/sib_text_secondary"
                            android:textSize="12sp"
                            android:gravity="center" />
                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
