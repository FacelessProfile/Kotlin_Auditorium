<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" app:cardCornerRadius="16dp" app:cardBackgroundColor="?attr/sib_bg_card" app:strokeWidth="1dp" app:strokeColor="?attr/sib_border_subtle">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
        <TextView android:id="@+id/appealDate" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="?attr/sib_text_secondary" android:textSize="12sp" />
        <TextView android:id="@+id/appealSubject" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textColor="?attr/sib_text_primary" android:textSize="18sp" android:textStyle="bold" />
        <TextView android:id="@+id/appealStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textColor="?attr/sib_text_primary" android:textStyle="bold" />
        <TextView android:id="@+id/appealMarks" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textColor="?attr/sib_text_primary" />
        <TextView android:id="@+id/appealReason" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:maxLines="3" android:ellipsize="end" android:textColor="?attr/sib_text_secondary" />
        <com.google.android.material.button.MaterialButton android:id="@+id/appealDetails" style="@style/Widget.MaterialComponents.Button.TextButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/appeal_details" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
