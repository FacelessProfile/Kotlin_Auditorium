<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="?attr/sib_bg_card"
    app:cardCornerRadius="20dp"
    app:cardElevation="8dp"
    app:strokeColor="?attr/sib_border_subtle"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="18dp"
            android:paddingTop="16dp"
            android:paddingBottom="10dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvCropTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Кадрирование фото"
                    android:textColor="?attr/sib_text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvCropSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Перемещайте и масштабируйте фото в круге"
                    android:textColor="?attr/sib_text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <ImageView
                android:id="@+id/btnCropClose"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:contentDescription="Закрыть"
                android:focusable="true"
                android:padding="6dp"
                android:src="@drawable/ic_cross"
                app:tint="?attr/sib_text_secondary" />
        </LinearLayout>

        <!-- Interactive Crop Area -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="250dp"
            android:background="#070A14">

            <com.example.kotlinroomdatabase.fragments.profile.AvatarCropView
                android:id="@+id/avatarCropView"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </FrameLayout>

        <!-- Tool bar: Zoom & Rotate controls -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/sib_bg_page"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingVertical="8dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnZoomOut"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:insetLeft="0dp"
                android:insetTop="0dp"
                android:insetRight="0dp"
                android:insetBottom="0dp"
                android:padding="0dp"
                app:cornerRadius="22dp"
                app:icon="@drawable/ic_zoom_out"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconSize="20dp"
                app:iconTint="?attr/sib_text_primary"
                app:strokeColor="?attr/sib_border_subtle" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnZoomIn"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="10dp"
                android:insetLeft="0dp"
                android:insetTop="0dp"
                android:insetRight="0dp"
                android:insetBottom="0dp"
                android:padding="0dp"
                app:cornerRadius="22dp"
                app:icon="@drawable/ic_zoom_in"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconSize="20dp"
                app:iconTint="?attr/sib_text_primary"
                app:strokeColor="?attr/sib_border_subtle" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRotateRight"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="10dp"
                android:insetLeft="0dp"
                android:insetTop="0dp"
                android:insetRight="0dp"
                android:insetBottom="0dp"
                android:padding="0dp"
                app:cornerRadius="22dp"
                app:icon="@drawable/ic_rotate_right"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconSize="20dp"
                app:iconTint="?attr/sib_text_primary"
                app:strokeColor="?attr/sib_border_subtle" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnResetCrop"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginStart="10dp"
                android:text="Сброс"
                android:textColor="@color/sib_blue_primary"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Live Preview Box -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardLivePreview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="10dp"
            app:cardBackgroundColor="?attr/sib_bg_page"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:strokeColor="?attr/sib_border_subtle"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="12dp">

                <!-- Circular Live Thumbnail -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    app:cardBackgroundColor="?attr/sib_bg_card"
                    app:cardCornerRadius="30dp"
                    app:cardElevation="2dp"
                    app:strokeColor="@color/sib_blue_primary"
                    app:strokeWidth="2.5dp">

                    <ImageView
                        android:id="@+id/previewAvatar"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="Предпросмотр аватара"
                        android:scaleType="centerCrop"
                        android:src="@drawable/ic_person" />
                </com.google.android.material.card.MaterialCardView>

                <!-- Mockup Profile Information -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Предпросмотр в профиле"
                        android:textColor="@color/sib_blue_primary"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvPreviewName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Студент СибГУТИ"
                        android:textColor="?attr/sib_text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvPreviewRole"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Студент"
                        android:textColor="?attr/sib_text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Actions: Cancel and Apply -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="16dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancelCrop"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:text="Отмена"
                android:textColor="?attr/sib_text_primary"
                app:cornerRadius="12dp"
                app:strokeColor="?attr/sib_border_subtle" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnApplyCrop"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1.2"
                android:backgroundTint="@color/sib_blue_primary"
                android:text="Применить"
                android:textColor="@color/sib_text_white"
                app:cornerRadius="12dp"
                app:icon="@drawable/ic_check"
                app:iconGravity="textStart"
                app:iconSize="18dp"
                app:iconTint="@color/sib_text_white" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
