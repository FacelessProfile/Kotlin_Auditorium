<?xml version="1.0" encoding="utf-8"?>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/swipeRefreshProfile"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/sib_bg_page">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- 1. Profile Identity Hero Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardProfileHero"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="?attr/sib_bg_card"
                app:cardCornerRadius="16dp"
                app:cardElevation="1dp"
                app:strokeColor="?attr/sib_border_subtle"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- Avatar with Change Photo Badge -->
                    <FrameLayout
                        android:layout_width="124dp"
                        android:layout_height="124dp">

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/cardProfileAvatar"
                            android:layout_width="114dp"
                            android:layout_height="114dp"
                            android:layout_gravity="center"
                            android:clickable="true"
                            android:focusable="true"
                            android:foreground="?attr/selectableItemBackground"
                            app:cardBackgroundColor="?attr/sib_bg_card"
                            app:cardCornerRadius="57dp"
                            app:cardElevation="4dp"
                            app:strokeColor="@color/sib_blue_primary"
                            app:strokeWidth="3.5dp">

                            <ImageView
                                android:id="@+id/profileAvatar"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:contentDescription="Аватар профиля"
                                android:scaleType="centerCrop"
                                android:src="@drawable/ic_person" />
                        </com.google.android.material.card.MaterialCardView>

                        <ImageView
                            android:id="@+id/btnChangeAvatarBadge"
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:layout_gravity="bottom|end"
                            android:layout_marginEnd="2dp"
                            android:layout_marginBottom="2dp"
                            android:background="@drawable/bg_badge_camera"
                            android:clickable="true"
                            android:contentDescription="Сменить фото"
                            android:elevation="6dp"
                            android:focusable="true"
                            android:padding="8dp"
                            android:src="@drawable/ic_camera"
                            app:tint="@color/sib_text_white" />
                    </FrameLayout>

                    <!-- User Name -->
                    <TextView
                        android:id="@+id/profileName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center"
                        android:text="Загрузка профиля..."
                        android:textColor="?attr/sib_text_primary"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <!-- Active Role Badge -->
                    <TextView
                        android:id="@+id/profileRoleBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_badge_type"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="4dp"
                        android:text="Студент"
                        android:textColor="@color/sib_blue_primary"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <!-- Role Switcher Button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSwitchRole"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:layout_marginTop="12dp"
                        android:paddingHorizontal="14dp"
                        android:text="Сменить роль"
                        android:textAllCaps="false"
                        android:textColor="@color/sib_blue_primary"
                        android:textSize="13sp"
                        android:visibility="gone"
                        tools:visibility="visible"
                        app:cornerRadius="20dp"
                        app:icon="@drawable/ic_refresh"
                        app:iconSize="16dp"
                        app:iconTint="@color/sib_blue_primary"
                        app:strokeColor="@color/sib_blue_primary"
                        app:strokeWidth="1dp" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 2. Personal Information Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                app:cardBackgroundColor="?attr/sib_bg_card"
                app:cardCornerRadius="16dp"
                app:cardElevation="1dp"
                app:strokeColor="?attr/sib_border_subtle"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:text="Персональные данные"
                        android:textColor="?attr/sib_text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <!-- Email -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingVertical="6dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Корпоративная почта"
                            android:textColor="?attr/sib_text_secondary"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/tvProfileEmail"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="--"
                            android:textColor="?attr/sib_text_primary"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="?attr/sib_border_subtle" />

                    <!-- Group / Department -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingVertical="6dp">

                        <TextView
                            android:id="@+id/tvLabelGroupOrDept"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Учебная группа / Кафедра"
                            android:textColor="?attr/sib_text_secondary"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/tvProfileGroup"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="--"
                            android:textColor="?attr/sib_text_primary"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="?attr/sib_border_subtle" />

                    <!-- ID / Document -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingVertical="6dp">

                        <TextView
                            android:id="@+id/tvLabelIdNumber"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Студенческий билет / Идентификатор"
                            android:textColor="?attr/sib_text_secondary"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/tvProfileIdNumber"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="--"
                            android:textColor="@color/sib_blue_primary"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="?attr/sib_border_subtle" />

                    <!-- Available Roles list -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingVertical="6dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Доступные роли"
                            android:textColor="?attr/sib_text_secondary"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/tvProfileAllRoles"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Студент"
                            android:textColor="?attr/sib_text_primary"
                            android:textSize="14sp" />
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 2.5. Student Subgroups Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardStudentSubgroups"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:visibility="gone"
                tools:visibility="visible"
                app:cardBackgroundColor="?attr/sib_bg_card"
                app:cardCornerRadius="16dp"
                app:cardElevation="1dp"
                app:strokeColor="?attr/sib_border_subtle"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:src="@drawable/ic_groups_badge"
                            app:tint="@color/sib_blue_primary" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Подгруппы по предметам"
                                android:textColor="?attr/sib_text_primary"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="Распределение для пар и лабораторных"
                                android:textColor="?attr/sib_text_secondary"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <ProgressBar
                            android:id="@+id/progressSubgroups"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:indeterminate="true"
                            android:visibility="gone"
                            tools:visibility="visible" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvSubgroupsHint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Нажмите на предмет, чтобы выбрать или сменить учебную подгруппу."
                        android:textColor="?attr/sib_text_secondary"
                        android:textSize="12sp" />

                    <!-- Container for dynamically added subjects -->
                    <LinearLayout
                        android:id="@+id/layoutSubgroupsList"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="vertical" />

                    <TextView
                        android:id="@+id/tvNoSubgroups"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Для вашей группы нет предметов с разделением на подгруппы."
                        android:textColor="?attr/sib_text_secondary"
                        android:textSize="13sp"
                        android:visibility="gone" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 3. Security & Agreements Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                app:cardBackgroundColor="?attr/sib_bg_card"
                app:cardCornerRadius="16dp"
                app:cardElevation="1dp"
                app:strokeColor="?attr/sib_border_subtle"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- 2FA Authenticator Row -->
                    <LinearLayout
                        android:id="@+id/rowTotpSecurity"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="16dp">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_marginEnd="14dp"
                            android:contentDescription="2FA"
                            android:src="@drawable/ic_security_badge"
                            app:tint="@color/sib_blue_primary" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="2FA Аутентификатор"
                                android:textColor="?attr/sib_text_primary"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Коды подтверждения входа"
                                android:textColor="?attr/sib_text_secondary"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:contentDescription="Перейти"
                            android:src="@drawable/ic_chevron_right"
                            app:tint="?attr/sib_text_muted" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="?attr/sib_border_subtle" />

                    <!-- User Agreement Row -->
                    <LinearLayout
                        android:id="@+id/rowUserAgreement"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="16dp">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_marginEnd="14dp"
                            android:contentDescription="Соглашение"
                            android:src="@drawable/ic_book_topic"
                            app:tint="@color/sib_blue_primary" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Пользовательское соглашение"
                                android:textColor="?attr/sib_text_primary"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvAgreementStatus"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Статус: принято"
                                android:textColor="@color/sib_success"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:contentDescription="Перейти"
                            android:src="@drawable/ic_chevron_right"
                            app:tint="?attr/sib_text_muted" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="?attr/sib_border_subtle" />

                    <!-- Server Settings Row -->
                    <LinearLayout
                        android:id="@+id/rowServerSettings"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="16dp">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_marginEnd="14dp"
                            android:contentDescription="Сервер"
                            android:src="@drawable/ic_settings"
                            app:tint="@color/sib_blue_primary" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Сервер подключения"
                                android:textColor="?attr/sib_text_primary"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvCurrentServerHost"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="--"
                                android:textColor="?attr/sib_text_secondary"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:contentDescription="Перейти"
                            android:src="@drawable/ic_chevron_right"
                            app:tint="?attr/sib_text_muted" />
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 4. Logout Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLogoutProfile"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="20dp"
                android:text="Выйти из учетной записи"
                android:textAllCaps="false"
                android:textColor="@color/sib_error_vibrant"
                android:textSize="14sp"
                app:cornerRadius="12dp"
                app:icon="@drawable/ic_logout"
                app:iconGravity="textStart"
                app:iconTint="@color/sib_error_vibrant"
                app:strokeColor="@color/sib_error_vibrant"
                app:strokeWidth="1dp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>