<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/scannerRootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <!-- Camera2 TextureView Preview -->
    <TextureView
        android:id="@+id/cameraTextureView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Center Viewfinder Target Frame -->
    <View
        android:id="@+id/viewfinderFrame"
        android:layout_width="260dp"
        android:layout_height="260dp"
        android:background="@drawable/bg_scanner_viewfinder"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.45" />

    <!-- Transparent Touch Gesture Interceptor Overlay -->
    <View
        android:id="@+id/viewGestureOverlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintBottom_toTopOf="@id/scannerBottomPanel"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/scannerTopBar" />

    <!-- Top Bar Controls -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/scannerTopBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="36dp"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btnScannerBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_scanner_btn_circle"
            android:contentDescription="Назад"
            android:padding="10dp"
            android:src="@drawable/ic_chevron_left"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <LinearLayout
            android:id="@+id/layoutScannerHeader"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="12dp"
            android:gravity="center"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btnScannerTorch"
            app:layout_constraintStart_toEndOf="@id/btnScannerBack"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/tvScannerTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Сканирование QR"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvScannerPrompt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Наведите камеру на QR-код"
                android:textColor="#CCFFFFFF"
                android:textSize="12sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnScannerTorch"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_scanner_btn_circle"
            android:contentDescription="Фонарик"
            android:padding="10dp"
            android:src="@drawable/ic_flash_off"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Floating Zoom Badge Indicator -->
    <TextView
        android:id="@+id/tvZoomBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_zoom_badge"
        android:elevation="6dp"
        android:gravity="center"
        android:paddingHorizontal="16dp"
        android:paddingVertical="6dp"
        android:text="1.0x"
        android:textColor="@color/white"
        android:textSize="14sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@id/scannerBottomPanel"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Bottom Zoom Control Panel -->
    <LinearLayout
        android:id="@+id/scannerBottomPanel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="32dp"
        android:background="@drawable/bg_scanner_panel"
        android:elevation="8dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="14dp"
        android:paddingBottom="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- Preset Zoom Buttons Row -->
        <LinearLayout
            android:id="@+id/layoutZoomPresets"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            android:weightSum="4">

            <TextView
                android:id="@+id/btnPreset1x"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_zoom_chip_selected"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="1x"
                android:textColor="@color/white"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnPreset2x"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_marginHorizontal="3dp"
                android:layout_weight="1"
                android:background="@drawable/bg_zoom_chip_unselected"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="2x"
                android:textColor="@color/white"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnPreset3x"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_marginHorizontal="3dp"
                android:layout_weight="1"
                android:background="@drawable/bg_zoom_chip_unselected"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="4.3x"
                android:textColor="@color/white"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnPreset5x"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_zoom_chip_unselected"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="10x"
                android:textColor="@color/white"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Continuous Zoom Slider Row -->
        <LinearLayout
            android:id="@+id/layoutZoomSlider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/ivZoomMin"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="Уменьшить"
                android:src="@drawable/ic_zoom_out"
                app:tint="#B3FFFFFF" />

            <SeekBar
                android:id="@+id/sbZoom"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="1000"
                android:progress="0"
                android:progressBackgroundTint="#4DFFFFFF"
                android:progressTint="#FFC48E17"
                android:thumbTint="#FFC48E17" />

            <ImageView
                android:id="@+id/ivZoomMax"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="Увеличить"
                android:src="@drawable/ic_zoom_in"
                app:tint="#B3FFFFFF" />
        </LinearLayout>

        <!-- Hint Text for Gestures -->
        <TextView
            android:id="@+id/tvZoomHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Щипок (pinch), кнопки или качель громкости для зума"
            android:textColor="#99FFFFFF"
            android:textSize="11sp" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
